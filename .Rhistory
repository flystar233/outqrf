current_r_sq <- 0
current_oob <- 0
# Loop through folds
for (k in 1:max(1, cv_folds)) {
if (cv_folds > 1) {
test_idx <- which(folds == k)
train_idx <- which(folds != k)
if (length(test_idx) == 0) next
} else {
test_idx <- 1:n_rows
train_idx <- 1:n_rows
}
qrf <- ranger::ranger(
formula = stats::reformulate(covariables, response = v),
data = data[train_idx, , drop = FALSE],
quantreg = TRUE,
num.trees = 500,
min.node.size = 10,
...
)
current_r_sq <- current_r_sq + qrf$r.squared
current_oob <- current_oob + qrf$prediction.error
pred <- predict(qrf, data[test_idx, covariables, drop = FALSE], type = "quantiles", quantiles = quantiles)
outMatrix[test_idx, ] <- pred$predictions
}
r_squared_list[v] <- current_r_sq / max(1, cv_folds)
oob_error_list[v] <- current_oob / max(1, cv_folds)
outMatrices[[v]] <- outMatrix
# --- Vectorized Rank Calculation ---
rank_value <- rowMeans(outMatrix <= response_vec, na.rm = TRUE)
median_idx <- ceiling(length(quantiles) / 2)
median_pred <- outMatrix[, median_idx]
diffs <- response_vec - median_pred
rmse_val <- sqrt(mean(diffs^2, na.rm = TRUE))
rmse_list[v] <- rmse_val
# --- Robust Magnitude Check ---
resid_mad <- mad(diffs, constant = 1.4826)
# Dynamic MAD factor check
is_magnitude_outlier <- abs(diffs) > actual_mad_factor * max(resid_mad, 1e-6)
outlier <- data.frame(
row = seq_len(n_rows),
col = v,
observed = response_vec,
predicted = median_pred,
rank = rank_value
)
if (weight) {
eff_r2 <- max(0, r_squared_list[v])
outlier <- dplyr::filter(outlier,
(rank <= threshold_low * eff_r2 | rank >= 1 - threshold_low * eff_r2) &
is_magnitude_outlier[row])
} else {
outlier <- dplyr::filter(outlier,
(rank <= threshold_low | rank >= threshold_high) &
is_magnitude_outlier[row])
}
outliers_list[[v]] <- outlier
}
if (verbose) cat("\nDone.\n")
outliers <- dplyr::bind_rows(outliers_list)
result <- list(
Data = data,
outliers = outliers,
n_outliers = table(outliers$col),
threshold = threshold,
rmse = rmse_list,
oob.error = oob_error_list,
r.squared = r_squared_list,
outMatrices = outMatrices,
quantiles_type = quantiles_type
)
class(result) <- "outqrf"
return(result)
}
qrf <- outqrf(data2,num.threads=8,quantiles_type=400)
qrf$outliers
qrf <- outqrf(data2,num.threads=8,quantiles_type=400,threshold = 0.0025,mad_factor = 5.5 )
View(qrf)
View(qrf)
View(qrf)
qrf$outliers
evaluateOutliers(data,data2,qrf$outliers)
#' @title Outlier detection using quantile random forest
#' @description Detects outliers using Quantile Random Forests with Cross-Validation.
#' @param data A data frame.
#' @param quantiles_type Quantile grid type: 1000, 400, or 40. Default is 1000.
#' @param threshold Outlier threshold (0-1) or "auto". Default is "auto".
#'   Auto logic: 0.025 for n<1000, scaling down to 0.001-0.0025 for large datasets.
#' @param cv_folds Number of cross-validation folds. Default is 5.
#' @param impute Whether to impute missing values. Default TRUE.
#' @param verbose Verbosity level. Default 1.
#' @param weight Whether to use weighted threshold. Default FALSE.
#' @param mad_factor Magnitude filter strictness. Default is NULL (auto-calculated based on sample size).
#'   Typical values are 3 (loose) to 6 (strict). Auto logic: 3 for n<1000, scaling up to ~4.5 for n=50000.
#' @param ... Additional arguments passed to ranger.
#' @return An object of class "outqrf" with outlier info and model stats.
#' @export
outqrf <- function(data,
quantiles_type = 1000,
threshold = "auto",
cv_folds = 5,
impute = TRUE,
verbose = 1,
weight = FALSE,
mad_factor = NULL,
...) {
# Input checks
if (!is.data.frame(data)) data <- as.data.frame(data)
if (!(quantiles_type %in% c(1000, 400, 40))) stop("quantiles_type should be one of 1000, 400, 40")
if (!requireNamespace("ranger", quietly = TRUE)) stop("Package 'ranger' is required.")
if (!requireNamespace("missRanger", quietly = TRUE)) stop("Package 'missRanger' is required.")
if (!requireNamespace("dplyr", quietly = TRUE)) stop("Package 'dplyr' is required.")
# Impute missing values
if (anyNA(data)) {
if (impute) {
if (verbose) cat("Imputing missing values...\n")
data <- missRanger::missRanger(data, pmm.k = 3, num.trees = 500, data_only = TRUE, verbose = 0)
} else {
stop("Missing values detected. Please impute them first!")
}
}
numeric_features <- names(data)[sapply(data, is.numeric)]
n_rows <- nrow(data)
# Auto-calculate threshold if not provided
if (threshold == "auto") {
# Determine minimum resolution based on quantiles_type
min_resolution <- switch(
as.character(quantiles_type),
"1000" = 0.001,
"400"  = 0.0025,
"40"   = 0.025
)
# Auto-select threshold based on data size
if (n_rows < 1000) {
# Small dataset: use moderate threshold
actual_threshold <- 0.025
} else if (n_rows < 10000) {
# Medium dataset: use stricter threshold
actual_threshold <- max(0.005, min_resolution)
} else {
# Large dataset: use very strict threshold to reduce false positives
# Scale logarithmically: for n=50000, target ~0.001-0.002
actual_threshold <- max(min_resolution, 0.001 + 0.001 * log10(n_rows / 10000))
actual_threshold <- min(actual_threshold, 0.0025)  # Cap at 0.25%
}
threshold <- actual_threshold
if (verbose) {
cat("Auto-selected threshold =", threshold, "for n =", n_rows, "\n")
}
} else {
if (!is.numeric(threshold) || threshold < 0 || threshold > 1) {
stop("Threshold should be a numeric value between 0 and 1, or 'auto'")
}
}
threshold_low <- threshold
threshold_high <- 1 - threshold
# Auto-calculate MAD factor if not provided
# Logic: 3.0 for small data, increasing logarithmically for large data to suppress false positives
if (is.null(mad_factor)) {
if (n_rows < 1000) {
actual_mad_factor <- 3.0
} else {
# For n=50000, log10(50000) is ~4.7. sqrt(2*log(50000)) is ~4.6
# We use a conservative approximation: 3 + 0.4 * log10(n/1000)
# n=1000 -> 3.0
# n=50000 -> 3 + 0.4 * 1.7 = 3.68.
# Let's be slightly more aggressive for large N to fight the tail:
# Use standard normal extreme value approximation: sqrt(2 * log(n))
# n=100 -> 3.0, n=10000 -> 4.3, n=50000 -> 4.6
actual_mad_factor <- sqrt(2 * log(n_rows)) * 0.9 # 0.9 as a slight relaxation factor
actual_mad_factor <- max(3.0, actual_mad_factor)
}
} else {
actual_mad_factor <- mad_factor
}
# Initialize result containers
rmse_list <- numeric(length(numeric_features))
oob_error_list <- numeric(length(numeric_features))
r_squared_list <- numeric(length(numeric_features))
names(rmse_list) <- numeric_features
names(oob_error_list) <- numeric_features
names(r_squared_list) <- numeric_features
outliers_list <- list()
outMatrices <- list()
# Generate quantile grid
quantiles <- switch(
as.character(quantiles_type),
"1000" = seq(0.001, 0.999, 0.001),
"400"  = seq(0.0025, 0.9975, 0.0025),
"40"   = seq(0.025, 0.975, 0.025)
)
if (verbose) {
cat("\nOutlier identification by quantile random forests\n")
cat("  Quantiles:\t\t", quantiles_type, "\n")
cat("  Threshold:\t\t", threshold, "\n")
cat("  CV Folds:\t\t", cv_folds, "\n")
cat("  MAD Factor:\t\t", round(actual_mad_factor, 2), ifelse(is.null(mad_factor), " (Auto)", ""), "\n")
cat("  Variables to check:\t", paste(numeric_features, collapse = ", "), "\n")
cat("\n  Checking: ")
}
if (cv_folds > 1) {
folds <- sample(rep(1:cv_folds, length.out = n_rows))
} else {
folds <- rep(1, n_rows)
}
for (v in numeric_features) {
if (verbose) cat(v, " ")
covariables <- setdiff(names(data), v)
response_vec <- data[[v]]
# Matrix to store predictions
outMatrix <- matrix(NA, nrow = n_rows, ncol = length(quantiles))
current_r_sq <- 0
current_oob <- 0
# Loop through folds
for (k in 1:max(1, cv_folds)) {
if (cv_folds > 1) {
test_idx <- which(folds == k)
train_idx <- which(folds != k)
if (length(test_idx) == 0) next
} else {
test_idx <- 1:n_rows
train_idx <- 1:n_rows
}
qrf <- ranger::ranger(
formula = stats::reformulate(covariables, response = v),
data = data[train_idx, , drop = FALSE],
quantreg = TRUE,
num.trees = 500,
min.node.size = 10,
...
)
current_r_sq <- current_r_sq + qrf$r.squared
current_oob <- current_oob + qrf$prediction.error
pred <- predict(qrf, data[test_idx, covariables, drop = FALSE], type = "quantiles", quantiles = quantiles)
outMatrix[test_idx, ] <- pred$predictions
}
r_squared_list[v] <- current_r_sq / max(1, cv_folds)
oob_error_list[v] <- current_oob / max(1, cv_folds)
outMatrices[[v]] <- outMatrix
# --- Vectorized Rank Calculation ---
rank_value <- rowMeans(outMatrix <= response_vec, na.rm = TRUE)
median_idx <- ceiling(length(quantiles) / 2)
median_pred <- outMatrix[, median_idx]
diffs <- response_vec - median_pred
rmse_val <- sqrt(mean(diffs^2, na.rm = TRUE))
rmse_list[v] <- rmse_val
# --- Robust Magnitude Check ---
resid_mad <- mad(diffs, constant = 1.4826)
# Dynamic MAD factor check
is_magnitude_outlier <- abs(diffs) > actual_mad_factor * max(resid_mad, 1e-6)
outlier <- data.frame(
row = seq_len(n_rows),
col = v,
observed = response_vec,
predicted = median_pred,
rank = rank_value
)
if (weight) {
eff_r2 <- max(0, r_squared_list[v])
outlier <- dplyr::filter(outlier,
(rank <= threshold_low * eff_r2 | rank >= 1 - threshold_low * eff_r2) &
is_magnitude_outlier[row])
} else {
outlier <- dplyr::filter(outlier,
(rank <= threshold_low | rank >= threshold_high) &
is_magnitude_outlier[row])
}
outliers_list[[v]] <- outlier
}
if (verbose) cat("\nDone.\n")
outliers <- dplyr::bind_rows(outliers_list)
result <- list(
Data = data,
outliers = outliers,
n_outliers = table(outliers$col),
threshold = threshold,
rmse = rmse_list,
oob.error = oob_error_list,
r.squared = r_squared_list,
outMatrices = outMatrices,
quantiles_type = quantiles_type
)
class(result) <- "outqrf"
return(result)
}
irisWithOutliers <- generateOutliers(iris, p = 0.05,seed =2024)
out <- outqrf(irisWithOutliers,quantiles_type=400)
out$outliers
evaluateOutliers(iris,irisWithOutliers,out$outliers)
irisWithOutliers <- generateOutliers(iris, p = 0.1,seed =2024)
out <- outqrf(irisWithOutliers,quantiles_type=400)
out$outliers
evaluateOutliers(iris,irisWithOutliers,out$outliers)
#' @title Outlier detection using quantile random forest
#' @description Detects outliers using Quantile Random Forests with Cross-Validation.
#' @param data A data frame.
#' @param quantiles_type Quantile grid type: 1000, 400, or 40. Default is 1000.
#' @param threshold Outlier threshold (0-1) or "auto". Default is "auto".
#'   Auto logic: 0.025 for n<1000, scaling down to 0.001-0.0025 for large datasets.
#' @param cv_folds Number of cross-validation folds. Default is 5.
#' @param impute Whether to impute missing values. Default TRUE.
#' @param verbose Verbosity level. Default 1.
#' @param weight Whether to use weighted threshold. Default FALSE.
#' @param mad_factor Magnitude filter strictness. Default is NULL (auto-calculated based on sample size).
#'   Typical values are 3 (loose) to 6 (strict). Auto logic: 3 for n<1000, scaling up to ~4.5 for n=50000.
#' @param ... Additional arguments passed to ranger. Recommended: num.trees = 200 (sufficient for outlier detection,
#'   default is 500 which may be excessive for this task).
#' @return An object of class "outqrf" with outlier info and model stats.
#' @export
outqrf <- function(data,
quantiles_type = 1000,
threshold = "auto",
cv_folds = 5,
impute = TRUE,
verbose = 1,
weight = FALSE,
mad_factor = NULL,
...) {
# Input checks
if (!is.data.frame(data)) data <- as.data.frame(data)
if (!(quantiles_type %in% c(1000, 400, 40))) stop("quantiles_type should be one of 1000, 400, 40")
if (!requireNamespace("ranger", quietly = TRUE)) stop("Package 'ranger' is required.")
if (!requireNamespace("missRanger", quietly = TRUE)) stop("Package 'missRanger' is required.")
if (!requireNamespace("dplyr", quietly = TRUE)) stop("Package 'dplyr' is required.")
# Impute missing values
if (anyNA(data)) {
if (impute) {
if (verbose) cat("Imputing missing values...\n")
data <- missRanger::missRanger(data, pmm.k = 3, num.trees = 500, data_only = TRUE, verbose = 0)
} else {
stop("Missing values detected. Please impute them first!")
}
}
numeric_features <- names(data)[sapply(data, is.numeric)]
n_rows <- nrow(data)
# Auto-calculate threshold if not provided
if (threshold == "auto") {
# Determine minimum resolution based on quantiles_type
min_resolution <- switch(
as.character(quantiles_type),
"1000" = 0.001,
"400"  = 0.0025,
"40"   = 0.025
)
# Auto-select threshold based on data size
if (n_rows < 1000) {
# Small dataset: use moderate threshold
actual_threshold <- 0.025
} else if (n_rows < 10000) {
# Medium dataset: use stricter threshold
actual_threshold <- max(0.005, min_resolution)
} else {
# Large dataset: use very strict threshold to reduce false positives
# Scale logarithmically: for n=50000, target ~0.001-0.002
actual_threshold <- max(min_resolution, 0.001 + 0.001 * log10(n_rows / 10000))
actual_threshold <- min(actual_threshold, 0.0025)  # Cap at 0.25%
}
threshold <- actual_threshold
if (verbose) {
cat("Auto-selected threshold =", threshold, "for n =", n_rows, "\n")
}
} else {
if (!is.numeric(threshold) || threshold < 0 || threshold > 1) {
stop("Threshold should be a numeric value between 0 and 1, or 'auto'")
}
}
threshold_low <- threshold
threshold_high <- 1 - threshold
# Auto-calculate MAD factor if not provided
# Logic: 3.0 for small data, increasing logarithmically for large data to suppress false positives
if (is.null(mad_factor)) {
if (n_rows < 1000) {
actual_mad_factor <- 3.0
} else {
# For n=50000, log10(50000) is ~4.7. sqrt(2*log(50000)) is ~4.6
# We use a conservative approximation: 3 + 0.4 * log10(n/1000)
# n=1000 -> 3.0
# n=50000 -> 3 + 0.4 * 1.7 = 3.68.
# Let's be slightly more aggressive for large N to fight the tail:
# Use standard normal extreme value approximation: sqrt(2 * log(n))
# n=100 -> 3.0, n=10000 -> 4.3, n=50000 -> 4.6
actual_mad_factor <- sqrt(2 * log(n_rows)) * 0.9 # 0.9 as a slight relaxation factor
actual_mad_factor <- max(3.0, actual_mad_factor)
}
} else {
actual_mad_factor <- mad_factor
}
# Initialize result containers
rmse_list <- numeric(length(numeric_features))
oob_error_list <- numeric(length(numeric_features))
r_squared_list <- numeric(length(numeric_features))
names(rmse_list) <- numeric_features
names(oob_error_list) <- numeric_features
names(r_squared_list) <- numeric_features
outliers_list <- list()
outMatrices <- list()
# Generate quantile grid
quantiles <- switch(
as.character(quantiles_type),
"1000" = seq(0.001, 0.999, 0.001),
"400"  = seq(0.0025, 0.9975, 0.0025),
"40"   = seq(0.025, 0.975, 0.025)
)
if (verbose) {
cat("\nOutlier identification by quantile random forests\n")
cat("  Quantiles:\t\t", quantiles_type, "\n")
cat("  Threshold:\t\t", threshold, "\n")
cat("  CV Folds:\t\t", cv_folds, "\n")
cat("  MAD Factor:\t\t", round(actual_mad_factor, 2), ifelse(is.null(mad_factor), " (Auto)", ""), "\n")
cat("  Variables to check:\t", paste(numeric_features, collapse = ", "), "\n")
cat("\n  Checking: ")
}
if (cv_folds > 1) {
folds <- sample(rep(1:cv_folds, length.out = n_rows))
} else {
folds <- rep(1, n_rows)
}
for (v in numeric_features) {
if (verbose) cat(v, " ")
covariables <- setdiff(names(data), v)
response_vec <- data[[v]]
# Matrix to store predictions
outMatrix <- matrix(NA, nrow = n_rows, ncol = length(quantiles))
current_r_sq <- 0
current_oob <- 0
# Loop through folds
for (k in 1:max(1, cv_folds)) {
if (cv_folds > 1) {
test_idx <- which(folds == k)
train_idx <- which(folds != k)
if (length(test_idx) == 0) next
} else {
test_idx <- 1:n_rows
train_idx <- 1:n_rows
}
# Use fewer trees for outlier detection (200 is usually sufficient)
# User can override via ... if needed
user_args <- list(...)
if (!"num.trees" %in% names(user_args)) {
user_args$num.trees <- 200  # Default: reduced from 500 for speed
}
qrf <- do.call(ranger::ranger, c(
list(
formula = stats::reformulate(covariables, response = v),
data = data[train_idx, , drop = FALSE],
quantreg = TRUE,
min.node.size = 10
),
user_args
))
current_r_sq <- current_r_sq + qrf$r.squared
current_oob <- current_oob + qrf$prediction.error
pred <- predict(qrf, data[test_idx, covariables, drop = FALSE], type = "quantiles", quantiles = quantiles)
outMatrix[test_idx, ] <- pred$predictions
}
r_squared_list[v] <- current_r_sq / max(1, cv_folds)
oob_error_list[v] <- current_oob / max(1, cv_folds)
outMatrices[[v]] <- outMatrix
# --- Vectorized Rank Calculation ---
rank_value <- rowMeans(outMatrix <= response_vec, na.rm = TRUE)
median_idx <- ceiling(length(quantiles) / 2)
median_pred <- outMatrix[, median_idx]
diffs <- response_vec - median_pred
rmse_val <- sqrt(mean(diffs^2, na.rm = TRUE))
rmse_list[v] <- rmse_val
# --- Robust Magnitude Check ---
resid_mad <- mad(diffs, constant = 1.4826)
# Dynamic MAD factor check
is_magnitude_outlier <- abs(diffs) > actual_mad_factor * max(resid_mad, 1e-6)
outlier <- data.frame(
row = seq_len(n_rows),
col = v,
observed = response_vec,
predicted = median_pred,
rank = rank_value
)
if (weight) {
eff_r2 <- max(0, r_squared_list[v])
outlier <- dplyr::filter(outlier,
(rank <= threshold_low * eff_r2 | rank >= 1 - threshold_low * eff_r2) &
is_magnitude_outlier[row])
} else {
outlier <- dplyr::filter(outlier,
(rank <= threshold_low | rank >= threshold_high) &
is_magnitude_outlier[row])
}
outliers_list[[v]] <- outlier
}
if (verbose) cat("\nDone.\n")
outliers <- dplyr::bind_rows(outliers_list)
result <- list(
Data = data,
outliers = outliers,
n_outliers = table(outliers$col),
threshold = threshold,
rmse = rmse_list,
oob.error = oob_error_list,
r.squared = r_squared_list,
outMatrices = outMatrices,
quantiles_type = quantiles_type
)
class(result) <- "outqrf"
return(result)
}
